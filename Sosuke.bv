-- 更新処理
local function Update()
    local pList = {}
    for _, p in pairs(Players:GetPlayers()) do if p ~= LP then table.insert(pList, p.Name) end end
    pcall(function() PTDropDown:Refresh(pList, true) end)
    pcall(function() ArashiDropDown:Refresh(pList, true) end)
    pcall(function() SpyDropDown:Refresh(pList, true) end)
end
Players.PlayerAdded:Connect(Update); Players.PlayerRemoving:Connect(Update); Update()
