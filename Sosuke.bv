-- TYHUB: ULTIMATE FULL VERSION V29 (FULL RESTORED & DAN ENGINE)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local FindFirstChild = game.FindFirstChild
local GetPlayers = Players.GetPlayers

-- HRP初期化 & 死亡時自動更新 (DAN Special指定)
local HRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    or LP.CharacterAdded:Wait():WaitForChild("HumanoidRootPart")

LP.CharacterAdded:Connect(function(char)
    HRP = char:WaitForChild("HumanoidRootPart")
end)

-- --- 全グローバル変数の初期化 ---
_G.SilentAimEnabled = false
_G.SilentAimRange = 30
_G.AutoAimEnabled = false
_G.AutoAimRange = 1000 
_G.SpeedEnabled = false
_G.CFrameSpeedValue = 1
_G.InfiniteJumpEnabled = false
_G.InfJumpLevel = 1
_G.NoclipEnabled = false
_G.JumpPowerEnabled = false
_G.JumpPowerValue = 50
_G.FOVEnabled = false
_G.FOVValue = 70
_G.ESPEnabled = false
_G.ESPNames = false
_G.ESPDistance = false
_G.LoopTPEnabled = false
_G.FollowEnabled = false
_G.FollowDistance = 3
_G.FollowSide = "Back"

local followTarget = ""
local selectedPlayer = "" 
local targetPlayerID = "" 
local spyTarget = nil    
local originalPos = nil  

-- --- 【DAN Special サイレントエイム (Raycast)】 ---
local function GetDirection(Origin, Position)
    return (Position - Origin).Unit * (Origin - Position).Magnitude
end

local function GetClosestPlayerInWorld()
    local Closest, Distance = nil, _G.SilentAimRange
    if not HRP then return nil end
    for _, Player in next, GetPlayers(Players) do
        if Player ~= LP then
            local Character = Player.Character
            local Head = Character and FindFirstChild(Character, "Head")
            local Humanoid = Character and FindFirstChild(Character, "Humanoid")
            if Head and Humanoid and Humanoid.Health > 0 then
                local d = (HRP.Position - Head.Position).Magnitude
                if d <= Distance then Closest = Head Distance = d end
            end
        end
    end
    return Closest
end

local oldNamecall = nil
local function HookSilentAim()
    if oldNamecall then return end
    oldNamecall = hookmetamethod(game, "__namecall", function(...)
        local Method = getnamecallmethod()
        local Arguments = {...}
        if _G.SilentAimEnabled and Arguments[1] == workspace and Method == "Raycast" then
            if typeof(Arguments[#Arguments]) == "RaycastParams" then
                local HitPart = GetClosestPlayerInWorld()
                if HitPart then
                    Arguments[3] = GetDirection(Arguments[2], HitPart.Position)
                    return oldNamecall(unpack(Arguments))
                end
            end
        end
        return oldNamecall(...)
    end)
end
HookSilentAim()

-- --- 【メインループ (FOV 70リセット / Speed / Follow / Noclip)】 ---
RunService.Stepped:Connect(function()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not HRP or not hum then return end

    if _G.NoclipEnabled then
        for _, v in pairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end
    if _G.JumpPowerEnabled then hum.JumpPower = _G.JumpPowerValue; hum.UseJumpPower = true end
    
    -- FOV制御: OFFの時は70に強制リセット
    if _G.FOVEnabled then 
        Camera.FieldOfView = _G.FOVValue 
    else
        if Camera.FieldOfView ~= 70 then Camera.FieldOfView = 70 end
    end

    if _G.AutoAimEnabled then
        local target = GetClosestPlayerInWorld() 
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
    
    if _G.SpeedEnabled and hum.MoveDirection.Magnitude > 0 then 
        HRP.CFrame = HRP.CFrame + (hum.MoveDirection * (_G.CFrameSpeedValue / 10)) 
    end
    
    if _G.FollowEnabled and followTarget ~= "" then
        local t = Players:FindFirstChild(followTarget); if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = t.Character.HumanoidRootPart
            local offset = (_G.FollowSide == "Front") and (tHRP.CFrame.LookVector * _G.FollowDistance) or (tHRP.CFrame.LookVector * -_G.FollowDistance)
            HRP.CFrame = tHRP.CFrame + offset
        end
    end
    if _G.LoopTPEnabled and selectedPlayer ~= "" then
        local t = Players:FindFirstChild(selectedPlayer); if t and t.Character then HRP.CFrame = t.Character.HumanoidRootPart.CFrame end
    end
end)

-- 無限ジャンプ (5段階)
UserInputService.JumpRequest:Connect(function()
    if _G.InfiniteJumpEnabled and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
        LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        if HRP then HRP.Velocity = Vector3.new(HRP.Velocity.X, (_G.InfJumpLevel * 20), HRP.Velocity.Z) end
    end
end)

-- --- ESP ---
local function CreateESP(Player)
    local Name = Drawing.new("Text")
    Name.Visible = false; Name.Color = Color3.new(1,1,1); Name.Size = 16; Name.Center = true; Name.Outline = true
    local Distance = Drawing.new("Text")
    Distance.Visible = false; Distance.Color = Color3.new(1,1,1); Distance.Size = 14; Distance.Center = true; Distance.Outline = true
    
    RunService.RenderStepped:Connect(function()
        if _G.ESPEnabled and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local p_hrp = Player.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(p_hrp.Position)
            if onScreen then
                if _G.ESPNames then Name.Text = Player.Name; Name.Position = Vector2.new(pos.X, pos.Y - 20); Name.Visible = true else Name.Visible = false end
                if _G.ESPDistance then
                    local d = (p_hrp.Position - (HRP and HRP.Position or Vector3.new())).Magnitude
                    Distance.Text = math.floor(d).."m"; Distance.Position = Vector2.new(pos.X, pos.Y + 5); Distance.Visible = true
                else Distance.Visible = false end
            else Name.Visible = false; Distance.Visible = false end
        else Name.Visible = false; Distance.Visible = false end
    end)
end
for _, p in pairs(Players:GetPlayers()) do if p ~= LP then CreateESP(p) end end
Players.PlayerAdded:Connect(CreateESP)

-- --- UI ---
local vu5 = loadstring(game:HttpGet("https://raw.githubusercontent.com/Jeffepicy/OrionGod/refs/heads/main/CosmicOrion", true))()
local Window = vu5:MakeWindow({ Name = "TYHUB V29", IntroText = "Welcome ゆらHUB", HidePremium = false, SaveConfig = false })

