PlayerTab:AddSlider({ Name = "Inf Jump Level / ジャンプ段階(1-5)", Min = 1, Max = 5, Default = 1, Increment = 1, Callback = function(v) _G.InfJumpLevel = v end })
PlayerTab:AddToggle({ Name = "Noclip / 壁貫通", Default = false, Callback = function(s) _G.NoclipEnabled = s end })

-- 4. Teleport / テレポート
local TeleportTab = Window:MakeTab({ Name = "Teleport / テレポート" })
TeleportTab:AddTextbox({ Name = "ID or Name / IDか名前を入力", Default = "", TextDisappear = false, Callback = function(v) targetPlayerID = v end })
TeleportTab:AddButton({ Name = "TP to ID / IDテレポート実行", Callback = function() 
    for _, p in pairs(Players:GetPlayers()) do if tostring(p.UserId) == targetPlayerID or p.Name:lower():find(targetPlayerID:lower()) then if p.Character then HRP.CFrame = p.Character.HumanoidRootPart.CFrame end break end end 
end })
